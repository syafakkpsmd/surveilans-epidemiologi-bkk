+                </tbody>
+              </table>
+              <p className="px-3 py-2 text-[11px] italic text-gray-400">{CATATAN_METODE_KLASIFIKASI}</p>
+            </div>
+          </td>
+        </tr>
+      )}
+    </>
+  );
+}
 
 export default function TabelHotspotHarian({ data }: { data: BarisTabelHotspot[] }) {
