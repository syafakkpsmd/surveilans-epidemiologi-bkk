+'use client';
+
+import { useMemo, useState } from 'react';
 import type { BarisTabelHotspot } from '@/lib/supabase/queries-karhutla-server';
+import { klasifikasiKabKota, CATATAN_METODE_KLASIFIKASI } from '@/lib/karhutla/klasifikasiKabKota';
+
+type RingkasanHarian = {
+  tanggal: string;
+  titik: BarisTabelHotspot[];
+  jumlahTitik: number;
+  confidenceRataRata: number;
+  frpTotal: number;
+  frpRataRata: number;
+  satelit: string[];
+};
+
+type GrupKabKota = {
+  nama: string;
+  titik: BarisTabelHotspot[];
+  jumlahTitik: number;
+  confidenceRataRata: number;
+  frpTotal: number;
+  frpRataRata: number;
+};
+
+function bulatkan(n: number, desimal = 2) {
+  return Math.round(n * 10 ** desimal) / 10 ** desimal;
+}
+
+function ringkasHarian(data: BarisTabelHotspot[]): RingkasanHarian[] {
+  const peta = new Map<string, BarisTabelHotspot[]>();
+  for (const h of data) {
+    const arr = peta.get(h.tanggal_deteksi) ?? [];
+    arr.push(h);
+    peta.set(h.tanggal_deteksi, arr);
+  }
+
+  return Array.from(peta.entries())
+    .map(([tanggal, titik]) => {
+      const confArr = titik.map((t) => t.confidence ?? 0).filter((v) => v > 0);
+      const frpArr = titik.map((t) => t.frp ?? 0).filter((v) => v > 0);
+      const satelit = Array.from(new Set(titik.map((t) => t.satelit).filter(Boolean))) as string[];
+      return {
+        tanggal,
+        titik,
+        jumlahTitik: titik.length,
+        confidenceRataRata: confArr.length ? bulatkan(confArr.reduce((a, b) => a + b, 0) / confArr.length, 0) : 0,
+        frpTotal: bulatkan(frpArr.reduce((a, b) => a + b, 0), 2),
+        frpRataRata: frpArr.length ? bulatkan(frpArr.reduce((a, b) => a + b, 0) / frpArr.length, 2) : 0,
+        satelit,
+      };
+    })
+    .sort((a, b) => (a.tanggal < b.tanggal ? 1 : -1));
+}
+
+function kelompokkanPerKabKota(titik: BarisTabelHotspot[]): GrupKabKota[] {
+  const peta = new Map<string, BarisTabelHotspot[]>();
+  for (const t of titik) {
+    const nama = klasifikasiKabKota(t.latitude, t.longitude);
+    const arr = peta.get(nama) ?? [];
+    arr.push(t);
+    peta.set(nama, arr);
+  }
+
+  return Array.from(peta.entries())
+    .map(([nama, titik]) => {
+      const confArr = titik.map((t) => t.confidence ?? 0).filter((v) => v > 0);
+      const frpArr = titik.map((t) => t.frp ?? 0).filter((v) => v > 0);
+      return {
+        nama,
+        titik: titik.sort((a, b) => (a.jam_deteksi ?? '').localeCompare(b.jam_deteksi ?? '')),
+        jumlahTitik: titik.length,
+        confidenceRataRata: confArr.length ? bulatkan(confArr.reduce((a, b) => a + b, 0) / confArr.length, 0) : 0,
+        frpTotal: bulatkan(frpArr.reduce((a, b) => a + b, 0), 2),
+        frpRataRata: frpArr.length ? bulatkan(frpArr.reduce((a, b) => a + b, 0) / frpArr.length, 2) : 0,
+      };
+    })
+    .sort((a, b) => b.jumlahTitik - a.jumlahTitik);
+}
+
+function BarisTitik({ h }: { h: BarisTabelHotspot }) {
+  return (
+    <tr>
+      <td className="px-3 py-1.5 pl-10 whitespace-nowrap text-gray-500">{h.jam_deteksi ?? '-'}</td>
+      <td className="px-3 py-1.5 whitespace-nowrap text-gray-500">
+        {h.latitude.toFixed(4)}, {h.longitude.toFixed(4)}
+      </td>
+      <td className="px-3 py-1.5 whitespace-nowrap">{h.confidence ?? '-'}%</td>
+      <td className="px-3 py-1.5 whitespace-nowrap text-gray-500">{h.satelit ?? '-'}</td>
+      <td className="px-3 py-1.5 whitespace-nowrap text-gray-500">{h.frp ?? '-'}</td>
+    </tr>
+  );
+}
+
+function GrupKabKotaBlok({ grup }: { grup: GrupKabKota }) {
+  const [buka, setBuka] = useState(false);
+  const diLuarKaltim = grup.nama.startsWith('Luar Kaltim');
+
+  return (
+    <>
+      <tr
+        className={`cursor-pointer select-none border-t border-gray-100 ${diLuarKaltim ? 'bg-amber-50/60' : 'bg-gray-50/70'} hover:bg-gray-100`}
+        onClick={() => setBuka((v) => !v)}
+      >
+        <td className="px-3 py-2 pl-6 whitespace-nowrap font-medium text-gray-800" colSpan={2}>
+          <span className="inline-block w-3 text-gray-400">{buka ? '▾' : '▸'}</span>
+          {grup.nama}
+          {diLuarKaltim ? <span className="ml-2 text-[10px] font-normal text-amber-600">estimasi &middot; di luar Kaltim</span> : null}
+        </td>
+        <td className="px-3 py-2 whitespace-nowrap text-gray-600">{grup.jumlahTitik} titik &middot; conf. {grup.confidenceRataRata}%</td>
+        <td className="px-3 py-2 whitespace-nowrap text-gray-600">FRP {grup.frpTotal}</td>
+        <td className="px-3 py-2 whitespace-nowrap text-gray-600">rata&sup2; {grup.frpRataRata}</td>
+      </tr>
+      {buka && (
+        <tr>
+          <td colSpan={5} className="p-0">
+            <table className="min-w-full text-sm">
+              <thead className="bg-white text-[11px] uppercase text-gray-400">
+                <tr>
+                  <th className="px-3 py-1 pl-10 text-left">Jam</th>
+                  <th className="px-3 py-1 text-left">Koordinat</th>
+                  <th className="px-3 py-1 text-left">Confidence</th>
+                  <th className="px-3 py-1 text-left">Satelit</th>
+                  <th className="px-3 py-1 text-left">FRP</th>
+                </tr>
+              </thead>
+              <tbody className="divide-y divide-gray-50">
+                {grup.titik.map((h) => (
+                  <BarisTitik key={h.id} h={h} />
+                ))}
+              </tbody>
+            </table>
+          </td>
+        </tr>
+      )}
+    </>
+  );
+}
+
+function BarisHarian({ r }: { r: RingkasanHarian }) {
