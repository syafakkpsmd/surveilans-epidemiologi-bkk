+  const grup = useMemo(() => (buka ? kelompokkanPerKabKota(r.titik) : []), [buka, r.titik]);
+
+  return (
+    <>
+      <tr className="cursor-pointer select-none hover:bg-gray-50" onClick={() => setBuka((v) => !v)}>
+        <td className="px-3 py-2 whitespace-nowrap">
+          <span className="inline-block w-4 text-gray-400">{buka ? '▾' : '▸'}</span>
+          {new Date(r.tanggal).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' })}
+        </td>
+        <td className="px-3 py-2 whitespace-nowrap font-medium text-gray-900">{r.jumlahTitik}</td>
+        <td className="px-3 py-2 whitespace-nowrap">{r.confidenceRataRata}%</td>
+        <td className="px-3 py-2 whitespace-nowrap">{r.frpTotal}</td>
+        <td className="px-3 py-2 whitespace-nowrap">{r.frpRataRata}</td>
+        <td className="px-3 py-2 whitespace-nowrap text-gray-500">{r.satelit.join(', ') || '-'}</td>
+      </tr>
+
+      {buka && (
+        <tr>
+          <td colSpan={6} className="p-0">
+            <div className="border-y border-gray-100 bg-gray-50/40">
+              <table className="min-w-full text-sm">
+                <thead className="bg-gray-100/70 text-[11px] uppercase text-gray-500">
+                  <tr>
+                    <th className="px-3 py-1.5 pl-6 text-left" colSpan={2}>
+                      Kabupaten/Kota
+                    </th>
+                    <th className="px-3 py-1.5 text-left">Ringkasan</th>
+                    <th className="px-3 py-1.5 text-left" colSpan={2} />
+                  </tr>
+                </thead>
+                <tbody>
+                  {grup.map((g) => (
