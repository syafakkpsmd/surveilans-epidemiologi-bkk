+function projeksiDunia(lon: number, lat: number, zoom: number) {
+  const scale = TILE * Math.pow(2, zoom);
+  const x = ((lon + 180) / 360) * scale;
+  const sinLat = Math.sin((lat * Math.PI) / 180);
+  const y = (0.5 - Math.log((1 + sinLat) / (1 - sinLat)) / (4 * Math.PI)) * scale;
+  return { x, y };
+}
+
+function latRad(lat: number) {
+  const sin = Math.sin((lat * Math.PI) / 180);
+  const radX2 = Math.log((1 + sin) / (1 - sin)) / 2;
+  return Math.max(Math.min(radX2, Math.PI), -Math.PI) / 2;
+}
+
+/** Hitung zoom kontinu (boleh pecahan, Mapbox Static API mendukungnya) supaya bbox pas di kanvas. */
+function hitungZoomFit(
+  bounds: { latMin: number; latMax: number; lngMin: number; lngMax: number },
+  lebarPx: number,
+  tinggiPx: number,
+  paddingPx: number
+) {
+  const latFraction = (latRad(bounds.latMax) - latRad(bounds.latMin)) / Math.PI || 0.0001;
+  let lngDiff = bounds.lngMax - bounds.lngMin;
+  if (lngDiff < 0) lngDiff += 360;
+  const lngFraction = (lngDiff || 0.0001) / 360;
 
-  return (lat: number, lng: number) => {
-    const x = PADDING + ((lng - lngMin) / rentangLng) * (LEBAR - PADDING * 2);
-    // lat lebih besar = lebih utara = y lebih kecil (SVG y ke bawah)
-    const y = PADDING + (1 - (lat - latMin) / rentangLat) * (TINGGI - PADDING * 2);
-    return { x, y };
+  const usableW = Math.max(lebarPx - paddingPx * 2, 40);
+  const usableH = Math.max(tinggiPx - paddingPx * 2, 40);
+
+  const latZoom = Math.log2(usableH / TILE / latFraction);
+  const lngZoom = Math.log2(usableW / TILE / lngFraction);
+
+  return Math.max(2, Math.min(latZoom, lngZoom, 15));
+}
+
+function hitungBounds(titik: TitikHotspotMini[]) {
+  const semuaLat = [...WILKER_LOKASI.map((w) => w.pusat.lat), ...titik.map((t) => t.latitude)];
+  const semuaLng = [...WILKER_LOKASI.map((w) => w.pusat.lng), ...titik.map((t) => t.longitude)];
+  return {
+    latMin: Math.min(...semuaLat),
+    latMax: Math.max(...semuaLat),
+    lngMin: Math.min(...semuaLng),
+    lngMax: Math.max(...semuaLng),
   };
 }
 
+// ============================================================
+// MODE UTAMA: peta satelit sungguhan (Mapbox Static Images API)
