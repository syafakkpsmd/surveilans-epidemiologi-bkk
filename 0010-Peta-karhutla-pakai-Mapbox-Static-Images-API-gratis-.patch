+function PetaSungguhan({ hotspots }: { hotspots: TitikHotspotMini[] }) {
+  const bounds = hitungBounds(hotspots);
+  const pusat = { lat: (bounds.latMin + bounds.latMax) / 2, lng: (bounds.lngMin + bounds.lngMax) / 2 };
+  const zoom = hitungZoomFit(bounds, LEBAR, TINGGI, PADDING + 20);
+
+  const urlPeta =
+    `https://api.mapbox.com/styles/v1/mapbox/${MAPBOX_STYLE}/static/` +
+    `${pusat.lng.toFixed(5)},${pusat.lat.toFixed(5)},${zoom.toFixed(2)},0/` +
+    `${LEBAR}x${TINGGI}@2x?access_token=${MAPBOX_TOKEN}`;
+
+  function keProyeksiPiksel(lon: number, lat: number) {
+    const pusatPx = projeksiDunia(pusat.lng, pusat.lat, zoom);
+    const p = projeksiDunia(lon, lat, zoom);
+    return { x: LEBAR / 2 + (p.x - pusatPx.x), y: TINGGI / 2 + (p.y - pusatPx.y) };
+  }
+
+  return (
+    <div style={{ position: 'relative', width: LEBAR, height: TINGGI }}>
+      {/* eslint-disable-next-line @next/next/no-img-element -- <img> biasa (BUKAN next/image) supaya
+          aman di-capture html-to-image, sama alasannya dgn logo header di komponen induk. */}
+      <img
+        src={urlPeta}
+        alt="Peta satelit sebaran titik panas Kalimantan Timur"
+        width={LEBAR}
+        height={TINGGI}
+        style={{ width: '100%', height: '100%', display: 'block', objectFit: 'cover', borderRadius: 16 }}
+        crossOrigin="anonymous"
+      />
+      <svg
+        viewBox={`0 0 ${LEBAR} ${TINGGI}`}
+        width={LEBAR}
+        height={TINGGI}
+        style={{ position: 'absolute', inset: 0, width: '100%', height: '100%' }}
+        xmlns="http://www.w3.org/2000/svg"
+      >
+        <defs>
+          <radialGradient id="haloPanasAsli" cx="50%" cy="50%" r="50%">
+            <stop offset="0%" stopColor="#ff5a4e" stopOpacity={0.85} />
+            <stop offset="100%" stopColor="#ff5a4e" stopOpacity={0} />
+          </radialGradient>
+        </defs>
+
+        {hotspots.map((h, i) => {
+          const { x, y } = keProyeksiPiksel(h.longitude, h.latitude);
+          return <circle key={`halo${i}`} cx={x} cy={y} r={14} fill="url(#haloPanasAsli)" />;
+        })}
+        {hotspots.map((h, i) => {
+          const { x, y } = keProyeksiPiksel(h.longitude, h.latitude);
+          return <circle key={i} cx={x} cy={y} r={3.5} fill="#ff8a72" fillOpacity={0.95} stroke="#fff1ee" strokeWidth={0.5} />;
+        })}
+
+        {WILKER_LOKASI.map((w) => {
+          const { x, y } = keProyeksiPiksel(w.pusat.lng, w.pusat.lat);
+          const nama = NAMA_WILKER[w.kode] ?? w.kode;
+          const dekatTepiKanan = x > LEBAR - 130;
+          return (
+            <g key={w.kode}>
+              <circle cx={x} cy={y} r={5} fill="#0f2a38" stroke="#ffd166" strokeWidth={2} />
+              <text
+                x={dekatTepiKanan ? x - 11 : x + 11}
+                y={y + 4}
+                textAnchor={dekatTepiKanan ? 'end' : 'start'}
+                fontSize={12}
+                fontWeight={700}
+                fill="#ffffff"
+                style={{ paintOrder: 'stroke', stroke: '#0a2c40', strokeWidth: 3 }}
+              >
+                {nama}
+              </text>
+            </g>
+          );
+        })}
+
+        <g transform={`translate(${PADDING}, ${TINGGI - 26})`}>
+          <rect x={-10} y={-16} width={230} height={38} rx={8} fill="#0a1929" fillOpacity={0.55} />
+          <circle cx={6} cy={0} r={4} fill="#ff8a72" />
+          <text x={16} y={4} fontSize={11} fill="#ffffff">Titik panas</text>
+          <circle cx={106} cy={0} r={5} fill="#0f2a38" stroke="#ffd166" strokeWidth={1.5} />
+          <text x={118} y={4} fontSize={11} fill="#ffffff">Wilayah kerja</text>
+        </g>
+      </svg>
+      <p
+        style={{
+          position: 'absolute',
