From 2b020a4b84b3bf333c6329d447cffd5552ea36d4 Mon Sep 17 00:00:00 2001
From: Syafa <syafa@bkk-samarinda.local>
Date: Sun, 30 Aug 2026 06:47:55 +0000
Subject: [PATCH 11/11] Tambah .env.example utk token Mapbox (template, bukan
 rahasia -- di-force-add krn .gitignore blokir pola .env*)

---
 .env.example | 15 +++++++++++++++
 1 file changed, 15 insertions(+)
 create mode 100644 .env.example

diff --git a/.env.example b/.env.example
new file mode 100644
index 0000000..4bf6fe9
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,15 @@
+# Peta satelit sungguhan di halaman Info Grafis Karhutla
+# (/dashboard/karhutla/infografis) -- pakai Mapbox Static Images API.
+#
+# 1. Daftar gratis (tanpa kartu kredit) di https://account.mapbox.com/auth/signup/
+# 2. Salin "Default public token" (diawali "pk.") dari dashboard akun Mapbox
+# 3. Isi di bawah ini
+#
+# Kalau dikosongkan, peta otomatis balik ke mode ilustrasi (siluet SVG),
+# aplikasi tetap jalan normal -- ini bukan wajib diisi.
+NEXT_PUBLIC_MAPBOX_TOKEN=
+
+# Opsional -- ganti gaya peta. Default: satelit+jalan (kelihatan tutupan
+# lahan/hutan asli, relevan utk konteks karhutla). Style lain yang valid
+# mis. "dark-v11", "outdoors-v12", "streets-v12".
+NEXT_PUBLIC_MAPBOX_STYLE=satellite-streets-v12
-- 
