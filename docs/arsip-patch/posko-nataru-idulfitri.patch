+import {
+  LABEL_POSKO,
+  WILAYAH_POSKO,
+  type DataPosko,
+  type WilayahPosko,
+} from '@/lib/posko/konstanta';
+import {
+  donutKelompok,
+  jumlahkanHarian,
+  ringkasPenyakit,
+  ringkasPtm,
+  saringHarian,
+  saringPenyakit,
