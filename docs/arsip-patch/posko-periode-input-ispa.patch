+  const ptm: Record<string, number> = {};
+  rPtm.forEach((r) => { ptm[String(r.jenis_ptm)] = angka(r.jumlah_kasus); });
+
+  return {
+    adaData: rPenyakit.length > 0 || rKlb.length > 0 || rPtm.length > 0,
+    penyakit,
+    klbJumlah: rKlb.length > 0 ? angka(rKlb[0].jumlah_klb) : null,
