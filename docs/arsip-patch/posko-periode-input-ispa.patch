+// ---------------------------------------------------------------- data input harian (untuk prefill form)
+export type InputHarianPosko = {
+  adaData: boolean;
+  /** jenis penyakit -> [kasusLkLt5, kasusLkGe5, kasusPrLt5, kasusPrGe5, matiLkLt5, matiLkGe5, matiPrLt5, matiPrGe5] */
+  penyakit: Record<string, number[]>;
