# Tambahkan ke .env.local (lokal) atau variabel env di panel hosting.
# Jangan commit file .env.local.
DB_HOST=127.0.0.1
DB_PORT=3307            # lokal (Docker) memakai 3307; di cPanel biasanya 3306 atau pakai DB_SOCKET
DB_USER=root            # di cPanel: nama pengguna database (berawalan nama akun)
DB_PASSWORD=ganti-ini
DB_NAME=epic_ai         # di cPanel: nama database (berawalan nama akun)
# DB_SOCKET=/var/lib/mysql/mysql.sock   # opsional, jika hanya bisa lewat socket
# DB_POOL_SIZE=5
