# Tambahkan ke .env.local (lokal) atau variabel env di panel hosting. Jangan commit .env.local.
# ===== Aplikasi (setelah pindah ke PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432             # PostgreSQL; MariaDB memakai 3306
DB_USER=ganti-ini        # di cPanel: nama pengguna PostgreSQL (berawalan nama akun)
DB_PASSWORD=ganti-ini
DB_NAME=ganti-ini        # di cPanel: nama database PostgreSQL (berawalan nama akun)
# DB_SOCKET=/var/run/postgresql   # opsional: DIREKTORI soket UNIX (menggantikan DB_HOST)
# DB_SSL=true                     # hanya bila server mewajibkan SSL
# DB_POOL_SIZE=5
# DATABASE_URL=postgres://user:sandi@host:5432/nama   # opsional: menggantikan DB_*

# ===== Hanya saat memindahkan data (skrip scripts/migrate/mariadb-ke-postgres.mjs) =====
# DB_* di atas dipakai sebagai SUMBER (MariaDB) selama migrasi, jadi isi DB_* dengan MariaDB dan PG_* dengan
# PostgreSQL tujuan. Setelah data pindah, ubah DB_* menjadi PostgreSQL dan hapus PG_*.
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=ganti-ini
# PG_PASSWORD=ganti-ini
# PG_DATABASE=ganti-ini

# Identitas instansi (opsional). Dipakai di judul, logo/alt, poster, laporan PPT, dan prompt analisis AI.
# Bila tidak diisi, bawaannya "BKK Kelas I Samarinda". BKK lain cukup mengisi baris di bawah lalu BUILD ULANG
# (variabel NEXT_PUBLIC_* ditanam saat build, jadi tidak cukup hanya restart).
# NEXT_PUBLIC_NAMA_BKK=BKK Kelas I Balikpapan
# NEXT_PUBLIC_NAMA_BKK_SINGKAT=BKK Balikpapan                                      (opsional)
# NEXT_PUBLIC_NAMA_RESMI_BKK=Balai Kekarantinaan Kesehatan Kelas I Balikpapan      (opsional)
# NEXT_PUBLIC_NAMA_KOTA_BKK=Balikpapan                                             (opsional)
# NEXT_PUBLIC_NAMA_PROVINSI_BKK=Kalimantan Timur                                   (opsional)
