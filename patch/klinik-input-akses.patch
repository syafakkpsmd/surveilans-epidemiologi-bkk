+              <label className="text-sm">Berkas (.xlsx / .xls)<br />
+                <input type="file" accept=".xlsx,.xls" className="text-sm" onChange={(e) => { setBerkas(e.target.files?.[0] ?? null); setPratinjau(null); setPesan(null); }} />
