+      return NextResponse.json({ mode, ...r, ditolak: h.galat.length });
+    }
+  } catch (e) {
+    return tangani(e, 'POST ' + aksi);
+  }
+  return galat('Aksi tidak dikenal', 404);
+}
+
+export async function DELETE(req: NextRequest, ctx: Ctx) {
